[configuration]

entry_symbol = "minesweeper_library_init"
compatibility_minimum = "4.6"

[libraries]

macos.debug = "res://bin/libgameplay.macos.template_debug.dev.framework"
macos.release = "res://bin/libgameplay.macos.template_release.framework"
windows.debug.x86_32 = "res://bin/libgameplay.windows.template_debug.dev.x86_32.dll"
windows.release.x86_32 = "res://bin/libgameplay.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/libgameplay.windows.template_debug.dev.x86_64.dll"
windows.release.x86_64 = "res://bin/libgameplay.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libgameplay.linux.template_debug.dev.x86_64.so"
linux.release.x86_64 = "res://bin/libgameplay.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libgameplay.linux.template_debug.dev.arm64.so"
linux.release.arm64 = "res://bin/libgameplay.linux.template_release.arm64.so"
linux.debug.rv64 = "res://bin/libgameplay.linux.template_debug.dev.rv64.so"
linux.release.rv64 = "res://bin/libgameplay.linux.template_release.rv64.so"
android.debug.x86_64 = "res://bin/libgameplay.android.template_debug.dev.x86_64.so"
android.release.x86_64 = "res://bin/libgameplay.android.template_release.x86_64.so"
android.debug.arm64 = "res://bin/libgameplay.android.template_debug.dev.arm64.so"
android.release.arm64 = "res://bin/libgameplay.android.template_release.arm64.so"
web.debug = "res://bin/libgameplay.web.template_debug.dev.wasm32.wasm"
web.release = "res://bin/libgameplay.web.template_release.wasm32.wasm"
